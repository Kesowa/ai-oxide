# Copy to .env and adjust for your environment. Never commit the real .env.

# ---- Object storage (S3 or MinIO) ----
# Required. The worker refuses to start without these.
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=aru
S3_ENDPOINT=http://localhost:9000
# true for MinIO and most S3-compatible stores, false for real AWS S3
S3_PATH_STYLE=true
S3_REGION=ap-south-1

# ---- Message broker ----
# Defaults to amqp://172.17.0.1:5672/%2f (the Docker bridge gateway) if unset.
AMQP_ADDR=amqp://guest:guest@localhost:5672/%2f

# ---- Logging ----
# Defaults to "info". Accepts any tracing/env-logger filter.
RUST_LOG=info
